{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-pdf-preview-gateway",
  "main": "src/gateway/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": { "required": ["DISCORD_BOT_TOKEN"] },
  "vars": { "GATEWAY_ENABLED": "true", "GATEWAY_INTENTS": "33281", "GATEWAY_REVISION": "1" },
  "durable_objects": { "bindings": [{ "name": "GATEWAY", "class_name": "Gateway" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Gateway"] }],
  "queues": { "producers": [{ "binding": "PREVIEWS", "queue": "discord-pdf-previews" }] },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
